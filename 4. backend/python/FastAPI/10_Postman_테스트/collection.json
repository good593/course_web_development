{
  "info": {
    "name": "쇼핑몰 REST API",
    "description": "10_Postman_테스트의 FastAPI 서버 테스트 컬렉션\n\n사용 전 Environment에서 base_url을 설정하세요.\n기본값: http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "demo-admin-token",
      "type": "string"
    },
    {
      "key": "product_name",
      "value": "테스트 상품",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "서버 상태 확인",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "서버가 정상 동작하는지 확인합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 200이어야 한다', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('응답 시간은 500ms 미만이어야 한다', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('status 필드가 ok이어야 한다', () => {",
                  "    pm.expect(body.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "상품 목록 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?page=1&size=10",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "size", "value": "10"},
                {"key": "category", "value": "", "disabled": true}
              ]
            },
            "description": "등록된 상품 목록을 조회합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 200이어야 한다', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('응답은 배열이어야 한다', () => {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 단건 조회",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/{{product_id}}",
            "description": "ID로 상품 상세 정보를 조회합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 200이어야 한다', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('id 필드가 있어야 한다', () => {",
                  "    pm.expect(body).to.have.property('id');",
                  "});",
                  "pm.test('price는 0보다 커야 한다', () => {",
                  "    pm.expect(body.price).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 등록",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{product_name}}\",\n  \"price\": 25000,\n  \"stock\": 100,\n  \"category\": \"전자제품\"\n}"
            },
            "description": "새 상품을 등록합니다."
          },
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "exec": [
                  "const rand = Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set('product_name', `테스트 상품 ${rand}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 201이어야 한다', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('생성된 상품에 id가 있어야 한다', () => {",
                  "    pm.expect(body).to.have.property('id');",
                  "});",
                  "// 생성된 상품 ID 저장",
                  "pm.collectionVariables.set('product_id', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 수정",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/products/{{product_id}}",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 22000,\n  \"stock\": 80\n}"
            },
            "description": "상품 정보를 부분적으로 수정합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 200이어야 한다', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('price가 22000으로 변경되었어야 한다', () => {",
                  "    pm.expect(body.price).to.eql(22000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 삭제",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/products/{{product_id}}",
            "description": "상품을 삭제합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 204이어야 한다', () => {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[에러] 존재하지 않는 상품 조회",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/99999",
            "description": "존재하지 않는 상품 → 404 확인"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 404이어야 한다', () => {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[에러] 필수 필드 누락",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 10\n}"
            },
            "description": "name, price 누락 → 422 확인"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 422이어야 한다', () => {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "주문 생성",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\"product_id\": 1, \"quantity\": 1},\n    {\"product_id\": 2, \"quantity\": 1}\n  ]\n}"
            },
            "description": "상품을 주문합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 201이어야 한다', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('total_price가 0보다 커야 한다', () => {",
                  "    pm.expect(body.total_price).to.be.above(0);",
                  "});",
                  "pm.test('status가 pending이어야 한다', () => {",
                  "    pm.expect(body.status).to.eql('pending');",
                  "});",
                  "pm.collectionVariables.set('order_id', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "주문 조회",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{order_id}}",
            "description": "주문 상세 정보를 조회합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 200이어야 한다', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('items 배열이 있어야 한다', () => {",
                  "    pm.expect(body.items).to.be.an('array');",
                  "    pm.expect(body.items.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "회원 가입",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"pass1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "exec": [
                  "// 매번 다른 이메일로 테스트",
                  "const rand = Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set('test_email', `test_${rand}@example.com`);",
                  "pm.collectionVariables.set('test_username', `user_${rand}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상태 코드는 201이어야 한다', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('응답에 password가 없어야 한다', () => {",
                  "    pm.expect(body).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
